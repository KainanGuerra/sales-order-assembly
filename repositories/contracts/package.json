{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "description": "gRPC contracts (.proto), generated TypeScript types and RabbitMQ event schemas shared by the services through a local package.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:generated": "pnpm generate && git diff --exit-code -- gen",
    "generate": "buf generate",
    "lint": "buf lint",
    "prebuild": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@grpc/grpc-js": "1.14.6",
    "@nestjs/common": "12.2.0",
    "@nestjs/microservices": "12.2.0",
    "@types/node": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-proto": "2.18.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./catalog": {
      "types": "./dist/gen/ts/sales/catalog/v1/catalog.d.ts",
      "default": "./dist/gen/ts/sales/catalog/v1/catalog.js"
    },
    "./identity": {
      "types": "./dist/gen/ts/sales/identity/v1/identity.d.ts",
      "default": "./dist/gen/ts/sales/identity/v1/identity.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  }
}

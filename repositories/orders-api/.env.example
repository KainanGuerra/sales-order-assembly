# --- Server ---
PORT=3003

# --- Database ---
# The role is created by infra/postgres/init-schemas.sh; the password is ORDERS_DB_PASSWORD.
DATABASE_URL=postgres://orders_role:<ORDERS_DB_PASSWORD>@127.0.0.1:5432/sales
DB_SCHEMA=orders

# --- Other services ---
CATALOG_GRPC_URL=catalog-api:50052
IDENTITY_GRPC_URL=identity-api:50051
GRPC_TIMEOUT_MS=3000
RABBITMQ_URL=amqp://sales:<RABBITMQ_PASSWORD>@rabbitmq:5672

# --- Seed ---
# The history orders of the seed are imported from this file at start.
SEED_FILE=../../seed.json
DEFAULT_PRICE_TABLE_ID=TP01

# --- Security ---
# Shared with the BFF; sent to catalog and identity. Server-side only, never sent to a browser.
INNER_AUTH=

# --- Business limits ---
# Orders below this net total, in cents, cannot be sent (R$ 300.00).
MIN_ORDER_CENTS=30000
# Global ceiling on the discount a seller may give without approval, in basis
# points (1000 = 10%). A seller's effective limit is the smaller of this and their own.
MAX_DISCOUNT_BP=1000

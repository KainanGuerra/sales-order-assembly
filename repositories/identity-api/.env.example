# --- Server ---
PORT=3001
GRPC_PORT=50051

# --- Database ---
# The role is created by infra/postgres/init-schemas.sh; the password is IDENTITY_DB_PASSWORD.
DATABASE_URL=postgres://identity_role:<IDENTITY_DB_PASSWORD>@127.0.0.1:5432/sales
DB_SCHEMA=identity

# --- Messaging ---
RABBITMQ_URL=amqp://sales:<RABBITMQ_PASSWORD>@rabbitmq:5672
# How long a credit hold lives if its order is never confirmed.
RESERVATION_TTL_SECONDS=900
# Redeliveries of a failing event before it goes to the dead-letter queue
# (5 means 6 attempts in all: the first delivery plus 5 more).
CONSUMER_MAX_DELIVERIES=5

# --- Security ---
# Shared with the BFF and orders-api. Server-side only, never sent to a browser.
INNER_AUTH=

# --- Behaviour ---
# Table used for a client with none of its own (an id from the catalog).
DEFAULT_PRICE_TABLE_ID=TP01
SEED_FILE=../../seed.json

# --- Server ---
PORT=3002
GRPC_PORT=50052

# --- Database ---
# The role is created by infra/postgres/init-schemas.sh; the password is CATALOG_DB_PASSWORD.
DATABASE_URL=postgres://catalog_role:change-me-catalog@127.0.0.1:5432/sales
DB_SCHEMA=catalog

# --- Security ---
# Shared with the BFF and orders-api. Server-side only, never sent to a browser.
INNER_AUTH=change-me-with-at-least-16-chars

# --- Behaviour ---
# On: an active product missing from the client's price table is shown disabled,
# and an inactive product appears on an exact EAN/SKU match. Off: both hidden.
SHOW_UNAVAILABLE_PRODUCTS=true

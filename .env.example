# Copy to .env and fill the empty values, or let scripts/init-env.sh generate
# random ones:  sh scripts/init-env.sh
# Nothing secret is committed; .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_PASSWORD=
# One password per service role (the roles are created by infra/postgres/init-schemas.sh)
IDENTITY_DB_PASSWORD=
CATALOG_DB_PASSWORD=
ORDERS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_PASSWORD=

# --- Redis (browser sessions) ---
REDIS_PASSWORD=

# --- Service-to-service ---
# Shared between the BFF and the backend services (at least 16 characters).
# Server-side only: it must never reach a browser.
INNER_AUTH=

# --- Behaviour ---
SHOW_UNAVAILABLE_PRODUCTS=true
# How long a credit hold lives if its order is never confirmed.
RESERVATION_TTL_SECONDS=900
# Redeliveries of a failing event before it is moved to the dead-letter queue
# (so 5 means 6 attempts in all: the first delivery plus 5 more).
CONSUMER_MAX_DELIVERIES=5
# Host port of the web app.
WEB_PORT=8080
# Set to true when the app is served over HTTPS (marks the session cookie Secure).
SESSION_COOKIE_SECURE=false
# Price table used for a client that has none of its own (the id of a catalog table).
DEFAULT_PRICE_TABLE_ID=TP01
# Orders below this net total (in cents) cannot be sent: R$ 300.00.
MIN_ORDER_CENTS=30000
# Global ceiling on the discount a seller may give without approval, in basis points (1000 = 10%).
# The effective limit of a seller is the smaller of this and their own.
MAX_DISCOUNT_BP=1000

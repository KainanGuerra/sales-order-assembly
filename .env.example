# Copy to .env and fill the empty values, or let scripts/init-env.sh generate
# random ones:  sh scripts/init-env.sh
# Nothing secret is committed; .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_PASSWORD=
# One password per service role (the roles are created by infra/postgres/init-schemas.sh)
IDENTITY_DB_PASSWORD=
CATALOG_DB_PASSWORD=
ORDERS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=

# --- Service-to-service ---
# Shared between the BFF and the backend services (at least 16 characters).
# Server-side only: it must never reach a browser.
INNER_AUTH=

# --- Behaviour ---
SHOW_UNAVAILABLE_PRODUCTS=true
